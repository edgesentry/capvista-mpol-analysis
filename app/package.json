{
  "name": "arktrace-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev:e2e": "VITE_MANIFEST_URL=http://127.0.0.1:5173/fixtures/ducklake_manifest.json vite --host 127.0.0.1 --port 5173",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173",
    "build:e2e": "VITE_MANIFEST_URL=http://127.0.0.1:4173/fixtures/ducklake_manifest.json npm run build",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test -c playwright.preview.config.ts",
    "test:e2e:install": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@tanstack/react-virtual": "^3.13.24",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  }
}
